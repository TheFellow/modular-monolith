<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:orders="using:Mixology.Desktop.Workspaces.Orders"
             xmlns:models="using:Mixology.Modules.Orders.Models"
             x:Name="OrderRoot"
             x:Class="Mixology.Desktop.Workspaces.Orders.OrdersView"
             x:DataType="orders:OrdersViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto"><StackPanel><TextBlock Text="Orders" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Place and track immutable fulfillment snapshots" Opacity="0.7"/></StackPanel><Button Grid.Column="1" Content="Place order" Command="{Binding StartPlaceCommand}" IsVisible="{Binding CanPlace}" AutomationProperties.Name="Place order"/><Button Grid.Column="2" Margin="8,0,0,0" Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh orders"/></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="140,180,*,90,Auto" ColumnSpacing="8"><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding FilterStatus}" AutomationProperties.Name="Order status filter"/><ComboBox Grid.Column="1" ItemsSource="{Binding Menus}" SelectedItem="{Binding FilterMenu}" DisplayMemberBinding="{Binding Display}" PlaceholderText="Any menu" AutomationProperties.Name="Order menu filter"/><TextBox Grid.Column="2" Text="{Binding FilterExpression}" PlaceholderText="Filter orders" AutomationProperties.Name="Order filter expression"/><TextBox Grid.Column="3" Text="{Binding PageSize}" PlaceholderText="Limit" AutomationProperties.Name="Order page size"/><Button Grid.Column="4" Content="Apply filter" Command="{Binding ApplyFilterCommand}" AutomationProperties.Name="Apply order filter"/></Grid>
    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="16">
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Orders"><ListBox.ItemTemplate><DataTemplate x:DataType="orders:OrderRowViewModel"><Grid ColumnDefinitions="2*,*,Auto" Margin="4,7"><StackPanel><TextBlock Text="{Binding MenuName}"/><TextBlock Text="{Binding Created}" Opacity="0.65"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}"/><TextBlock Grid.Column="2" Text="{Binding Items}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Order detail and place form"><StackPanel Spacing="12">
        <StackPanel IsVisible="{Binding IsDetail}" Spacing="8">
          <TextBlock Text="Order detail" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail.Id}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail.Status}"/><TextBlock Text="{Binding Detail.Notes}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail.Tags}" TextWrapping="Wrap"/>
          <WrapPanel><Button Content="Complete" Command="{Binding BeginCompleteCommand}" IsVisible="{Binding CanComplete}" AutomationProperties.Name="Complete order"/><Button Content="Cancel order" Command="{Binding BeginCancelOrderCommand}" IsVisible="{Binding CanCancel}" AutomationProperties.Name="Cancel order"/></WrapPanel>
          <Border IsVisible="{Binding IsCompleteConfirmation}" Padding="12" BorderThickness="1"><StackPanel><TextBlock Text="Complete this order? Reserved usage will remain immutable." TextWrapping="Wrap"/><WrapPanel><Button Content="Confirm complete" Command="{Binding CompleteCommand}" AutomationProperties.Name="Confirm complete order"/><Button Content="Keep pending" Command="{Binding DismissConfirmationCommand}"/></WrapPanel></StackPanel></Border>
          <Border IsVisible="{Binding IsCancelConfirmation}" Padding="12" BorderThickness="1"><StackPanel><TextBlock Text="Cancel this order? This cannot be undone." TextWrapping="Wrap"/><WrapPanel><Button Content="Confirm cancel" Command="{Binding CancelOrderCommand}" AutomationProperties.Name="Confirm cancel order"/><Button Content="Keep order" Command="{Binding DismissConfirmationCommand}"/></WrapPanel></StackPanel></Border>
          <TextBlock Text="Ordered items" FontSize="20" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding DetailLines}" AutomationProperties.Name="Order items"><ItemsControl.ItemTemplate><DataTemplate x:DataType="orders:OrderLineViewModel"><TextBlock Text="{Binding Display}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Reserved ingredient usage (immutable)" FontSize="20" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Detail.IngredientUsage}" AutomationProperties.Name="Order ingredient usage"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:IngredientUsage"><Grid ColumnDefinitions="2*,*" Margin="0,3"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Amount}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Blocked ingredient IDs" FontSize="20" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Detail.BlockedIngredientIds}" AutomationProperties.Name="Blocked order ingredients"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsPlace}" Spacing="8">
          <TextBlock Text="Place order" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Published menu"/><ComboBox ItemsSource="{Binding Menus}" SelectedItem="{Binding PlaceMenu}" DisplayMemberBinding="{Binding Display}" AutomationProperties.Name="Order menu"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox ItemsSource="{Binding Drinks}" SelectedItem="{Binding PlaceDrink}" DisplayMemberBinding="{Binding Display}" AutomationProperties.Name="Order drink"/><Button Grid.Column="1" Content="Add item" Command="{Binding AddLineCommand}" AutomationProperties.Name="Add order item"/></Grid>
          <ItemsControl ItemsSource="{Binding PlaceLines}" AutomationProperties.Name="Order placement items"><ItemsControl.ItemTemplate><DataTemplate x:DataType="orders:OrderPlacementLine"><Grid ColumnDefinitions="2*,80,2*,Auto" ColumnSpacing="8" Margin="0,4"><TextBlock Text="{Binding Drink.Display}" TextWrapping="Wrap"/><TextBox Grid.Column="1" Text="{Binding Quantity}" AutomationProperties.Name="Order item quantity"/><TextBox Grid.Column="2" Text="{Binding Notes}" PlaceholderText="Line notes" AutomationProperties.Name="Order item notes"/><Button Grid.Column="3" Content="Remove" Command="{Binding #OrderRoot.DataContext.RemoveLineCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Remove order item"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Order notes"/><TextBox Text="{Binding PlaceNotes}" PlaceholderText="Order notes" AcceptsReturn="True" MinHeight="70" AutomationProperties.Name="Order notes"/><TextBlock Text="Tags (case-sensitive CSV)"/><TextBox Text="{Binding PlaceTags}" AutomationProperties.Name="Order tags"/>
          <WrapPanel><Button Content="Submit order" Command="{Binding PlaceCommand}" AutomationProperties.Name="Submit order"/><Button Content="Cancel" Command="{Binding CancelPlaceCommand}" AutomationProperties.Name="Cancel order form"/></WrapPanel>
        </StackPanel>
      </StackPanel></ScrollViewer>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><Button Content="Previous" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Previous order page"/><Button Grid.Column="1" Content="Next" Command="{Binding NextPageCommand}" AutomationProperties.Name="Next order page"/><StackPanel Grid.Column="2"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"/><TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/></StackPanel></Grid>
  </Grid>
</UserControl>
