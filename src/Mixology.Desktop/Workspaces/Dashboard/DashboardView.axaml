<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="using:Mixology.Desktop.Workspaces.Dashboard"
             x:Class="Mixology.Desktop.Workspaces.Dashboard.DashboardView"
             x:DataType="dashboard:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="Current bar activity and operational totals" Opacity="0.7" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                AutomationProperties.Name="Refresh dashboard" />
      </Grid>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRefreshing}"
                   AutomationProperties.Name="Loading dashboard" />
      <WrapPanel Orientation="Horizontal">
        <Border Classes="metric"><StackPanel><TextBlock Text="Drinks" /><TextBlock Text="{Binding DrinkCount}" FontSize="28" /></StackPanel></Border>
        <Border Classes="metric"><StackPanel><TextBlock Text="Ingredients" /><TextBlock Text="{Binding IngredientCount}" FontSize="28" /></StackPanel></Border>
        <Border Classes="metric"><StackPanel><TextBlock Text="Inventory" /><TextBlock Text="{Binding InventoryCount}" FontSize="28" /></StackPanel></Border>
        <Border Classes="metric"><StackPanel><TextBlock Text="Low stock" /><TextBlock Text="{Binding LowStockCount}" FontSize="28" /></StackPanel></Border>
        <Border Classes="metric"><StackPanel><TextBlock Text="Menus" /><TextBlock Text="{Binding MenuCount}" FontSize="28" /><TextBlock Text="{Binding MenuStatus}" /></StackPanel></Border>
        <Border Classes="metric"><StackPanel><TextBlock Text="Orders" /><TextBlock Text="{Binding OrderCount}" FontSize="28" /><TextBlock Text="{Binding PendingOrderCount, StringFormat='{}{0} pending'}" /></StackPanel></Border>
        <Border Classes="metric"><StackPanel><TextBlock Text="Audit entries" /><TextBlock Text="{Binding AuditCount}" FontSize="28" /></StackPanel></Border>
      </WrapPanel>
      <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                 AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding RecentActivity}" AutomationProperties.Name="Recent activity">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dashboard:DashboardActivityViewModel">
            <Grid ColumnDefinitions="160,150,*" Margin="0,4">
              <TextBlock Text="{Binding Timestamp}" />
              <TextBlock Grid.Column="1" Text="{Binding Actor}" />
              <TextBlock Grid.Column="2" Text="{Binding Action}" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
  <UserControl.Styles>
    <Style Selector="Border.metric">
      <Setter Property="Width" Value="190" />
      <Setter Property="MinHeight" Value="108" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Styles>
</UserControl>
