<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:desktop="clr-namespace:Mixology.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dashboard="clr-namespace:Mixology.Desktop.Workspaces.Dashboard"
             x:Class="Mixology.Desktop.Workspaces.Dashboard.DashboardView"
             x:DataType="dashboard:DashboardViewModel">
  <ScrollView>
    <VerticalStackLayout Margin="28" Spacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <VerticalStackLayout>
          <Label Text="Dashboard" FontSize="30" FontAttributes="Bold" />
          <Label Text="Current bar activity and operational totals" Opacity="0.7" />
        </VerticalStackLayout>
        <Button Grid.Column="1" Text="Refresh" Command="{Binding RefreshCommand}"
                SemanticProperties.Description="Refresh dashboard" />
      </Grid>
      <ActivityIndicator IsRunning="{Binding IsRefreshing}" IsVisible="{Binding IsRefreshing}"
                   SemanticProperties.Description="Loading dashboard" />
      <FlexLayout Direction="Row" Wrap="Wrap">
        <Border Style="{StaticResource MetricBorderStyle}"><VerticalStackLayout><Label Text="Drinks" /><Label Text="{Binding DrinkCount}" FontSize="28" /></VerticalStackLayout></Border>
        <Border Style="{StaticResource MetricBorderStyle}"><VerticalStackLayout><Label Text="Ingredients" /><Label Text="{Binding IngredientCount}" FontSize="28" /></VerticalStackLayout></Border>
        <Border Style="{StaticResource MetricBorderStyle}"><VerticalStackLayout><Label Text="Inventory" /><Label Text="{Binding InventoryCount}" FontSize="28" /></VerticalStackLayout></Border>
        <Border Style="{StaticResource MetricBorderStyle}"><VerticalStackLayout><Label Text="Low stock" /><Label Text="{Binding LowStockCount}" FontSize="28" /></VerticalStackLayout></Border>
        <Border Style="{StaticResource MetricBorderStyle}"><VerticalStackLayout><Label Text="Menus" /><Label Text="{Binding MenuCount}" FontSize="28" /><Label Text="{Binding MenuStatus}" /></VerticalStackLayout></Border>
        <Border Style="{StaticResource MetricBorderStyle}"><VerticalStackLayout><Label Text="Orders" /><Label Text="{Binding OrderCount}" FontSize="28" /><Label Text="{Binding PendingOrderCount, StringFormat='{}{0} pending'}" /></VerticalStackLayout></Border>
        <Border Style="{StaticResource MetricBorderStyle}"><VerticalStackLayout><Label Text="Audit entries" /><Label Text="{Binding AuditCount}" FontSize="28" /></VerticalStackLayout></Border>
      </FlexLayout>
      <Label Text="{Binding StatusMessage}" TextColor="Red"
                 />
      <Label Text="Recent activity" FontSize="20" FontAttributes="Bold" />
      <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}" SemanticProperties.Description="Recent activity">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="dashboard:DashboardActivityViewModel">
            <Grid ColumnDefinitions="160,150,*" Margin="0,4">
              <Label Text="{Binding Timestamp}" />
              <Label Grid.Column="1" Text="{Binding Actor}" />
              <Label Grid.Column="2" Text="{Binding Action}" LineBreakMode="WordWrap" />
            </Grid>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentView>
