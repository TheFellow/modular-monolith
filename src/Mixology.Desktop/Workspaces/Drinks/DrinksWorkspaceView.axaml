<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:drinks="using:Mixology.Desktop.Workspaces.Drinks"
             xmlns:drinkModels="using:Mixology.Modules.Drinks.Models"
             xmlns:entities="using:Mixology.Kernel.Entities"
             xmlns:system="using:System"
             x:Class="Mixology.Desktop.Workspaces.Drinks.DrinksWorkspaceView"
             x:DataType="drinks:DrinksWorkspaceViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <StackPanel>
        <TextBlock Text="Drinks" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="Catalog, recipes, and service details" Opacity="0.7" />
      </StackPanel>
      <Button Grid.Column="1" Content="Filters" Command="{Binding ToggleFiltersCommand}"
              AutomationProperties.Name="Toggle drink filters" />
      <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
              AutomationProperties.Name="Refresh drinks" />
      <Button Grid.Column="3" Content="Create drink" Command="{Binding StartCreateCommand}"
              IsVisible="{Binding CreateAction.Visible}" IsEnabled="{Binding CreateAction.Enabled}"
              ToolTip.Tip="{Binding CreateAction.DisabledReason}"
              AutomationProperties.Name="Create drink"
              AutomationProperties.HelpText="{Binding CreateAction.AccessibilityDescription}" />
    </Grid>

    <Border Grid.Row="1" IsVisible="{Binding ShowFilters}" Classes="panel" Margin="0,16,0,12">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,*,*,2*" ColumnSpacing="8">
          <TextBox PlaceholderText="Exact name" Text="{Binding ExactNameFilter}"
                   AutomationProperties.Name="Exact drink name filter" />
          <TextBox Grid.Column="1" PlaceholderText="Category" Text="{Binding CategoryFilter}"
                   AutomationProperties.Name="Drink category filter" />
          <TextBox Grid.Column="2" PlaceholderText="Glass" Text="{Binding GlassFilter}"
                   AutomationProperties.Name="Drink glass filter" />
          <TextBox Grid.Column="3" PlaceholderText="Filter expression" Text="{Binding ExpressionFilter}"
                   AutomationProperties.Name="Drink filter expression" />
        </Grid>
        <Grid ColumnDefinitions="160,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding PageSize}" PlaceholderText="Page size"
                   AutomationProperties.Name="Drink page size" />
          <Button Grid.Column="1" Content="Apply" Command="{Binding ApplyFilterCommand}"
                  AutomationProperties.Name="Apply drink filters" />
          <Button Grid.Column="2" Content="Clear" Command="{Binding ClearFilterCommand}"
                  AutomationProperties.Name="Clear drink filters" />
          <Button Grid.Column="3" Content="Filter help" Command="{Binding ToggleFilterHelpCommand}"
                  AutomationProperties.Name="Show drink filter help" />
        </Grid>
        <TextBlock Text="{Binding FilterHelp}" IsVisible="{Binding ShowFilterHelp}"
                   TextWrapping="Wrap" AutomationProperties.Name="Drink filter help" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="18" Margin="0,12,0,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                     AutomationProperties.Name="Loading drinks" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 AutomationProperties.Name="Drink catalog">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="drinks:DrinkListItemViewModel">
              <Grid ColumnDefinitions="2*,*,*" Margin="6" ColumnSpacing="8">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Tags}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Category}" />
                <TextBlock Grid.Column="2" Text="{Binding Glass}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
          <Button Content="Previous" Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding HasPreviousPage}" AutomationProperties.Name="Previous drink page" />
          <TextBlock Grid.Column="1" Text="{Binding PageDescription}" HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Next" Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding HasNextPage}" AutomationProperties.Name="Next drink page" />
        </Grid>
      </Grid>

      <Border Grid.Column="1" Classes="panel">
        <Grid>
          <ScrollViewer IsVisible="{Binding IsDetail}">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Detail.Name}" FontSize="24" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="Category" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Detail.Category.Value}" />
                <TextBlock Grid.Row="1" Text="Glass" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.Glass.Value}" />
                <TextBlock Grid.Row="2" Text="Status" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.Status.Value}" />
                <TextBlock Grid.Row="3" Text="Description" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.Description}" TextWrapping="Wrap" />
              </Grid>
              <TextBlock Text="Recipe" FontSize="18" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Detail.Recipe.Ingredients}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="drinkModels:RecipeIngredient">
                    <StackPanel Margin="0,3">
                      <TextBlock Text="{Binding IngredientId.Value, StringFormat='Ingredient: {0}'}" />
                      <TextBlock Text="{Binding Amount, StringFormat='Amount: {0}'}" />
                      <TextBlock Text="{Binding Optional, StringFormat='Optional: {0}'}" />
                      <ItemsControl ItemsSource="{Binding Substitutes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="entities:IngredientId">
                            <TextBlock Text="{Binding Value, StringFormat='Substitute: {0}'}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Detail.Recipe.Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="system:String">
                    <TextBlock Text="{Binding}" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding Detail.Recipe.Garnish, StringFormat='Garnish: {0}'}" />
              <TextBlock Text="{Binding Detail.Tags, StringFormat='Tags: {0}'}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Edit" Command="{Binding StartEditCommand}"
                        IsVisible="{Binding EditAction.Visible}" IsEnabled="{Binding EditAction.Enabled}"
                        ToolTip.Tip="{Binding EditAction.DisabledReason}" AutomationProperties.Name="Edit drink"
                        AutomationProperties.HelpText="{Binding EditAction.AccessibilityDescription}" />
                <Button Content="Delete" Command="{Binding BeginDeleteCommand}"
                        IsVisible="{Binding DeleteAction.Visible}" IsEnabled="{Binding DeleteAction.Enabled}"
                        ToolTip.Tip="{Binding DeleteAction.DisabledReason}" AutomationProperties.Name="Delete drink"
                        AutomationProperties.HelpText="{Binding DeleteAction.AccessibilityDescription}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsForm}" VerticalScrollBarVisibility="Auto"
                        AutomationProperties.Name="Drink editor">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding FormTitle}" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="Name" FontWeight="SemiBold" />
              <TextBox Text="{Binding Name}" AutomationProperties.Name="Drink name" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="Category" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                            AutomationProperties.Name="Drink category" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="Glass" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding Glasses}" SelectedItem="{Binding Glass}"
                            AutomationProperties.Name="Drink glass" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Description" FontWeight="SemiBold" />
              <TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="72"
                       AutomationProperties.Name="Drink description" />

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Recipe ingredients" FontSize="18" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Add ingredient" Command="{Binding Recipe.AddIngredientCommand}"
                        AutomationProperties.Name="Add recipe ingredient" />
              </Grid>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCatalogLoading}"
                           AutomationProperties.Name="Loading ingredient catalog" />
              <ItemsControl ItemsSource="{Binding Recipe.Ingredients}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="drinks:RecipeIngredientViewModel">
                    <Border Classes="recipeRow" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="8">
                          <StackPanel>
                            <TextBlock Text="Ingredient search" />
                            <TextBox Text="{Binding IngredientSearch}"
                                     AutomationProperties.Name="Recipe ingredient search" />
                            <ComboBox ItemsSource="{Binding IngredientMatches}"
                                      SelectedItem="{Binding SelectedIngredient}"
                                      AutomationProperties.Name="Recipe ingredient picker">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="drinks:IngredientOptionViewModel">
                                  <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="Amount" />
                            <TextBox Text="{Binding Amount}" AutomationProperties.Name="Recipe amount" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="Unit" />
                            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                                      AutomationProperties.Name="Recipe unit" />
                          </StackPanel>
                          <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}"
                                  VerticalAlignment="Bottom" AutomationProperties.Name="Remove recipe ingredient" />
                        </Grid>
                        <CheckBox Content="Optional ingredient" IsChecked="{Binding IsOptional}"
                                  AutomationProperties.Name="Optional recipe ingredient" />
                        <TextBlock Text="Allowed substitutes" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding SubstituteOptions}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="drinks:SubstituteOptionViewModel">
                              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,12,4"
                                        AutomationProperties.Name="Recipe substitute" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Ordered steps" FontSize="18" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Add step" Command="{Binding Recipe.AddStepCommand}"
                        AutomationProperties.Name="Add recipe step" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Recipe.Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="drinks:RecipeStepViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,3">
                      <TextBox Text="{Binding Text}" PlaceholderText="Instruction"
                               AutomationProperties.Name="Recipe step" />
                      <Button Grid.Column="1" Content="↑" Command="{Binding MoveUpCommand}"
                              AutomationProperties.Name="Move recipe step up" />
                      <Button Grid.Column="2" Content="↓" Command="{Binding MoveDownCommand}"
                              AutomationProperties.Name="Move recipe step down" />
                      <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}"
                              AutomationProperties.Name="Remove recipe step" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Garnish" FontWeight="SemiBold" />
              <TextBox Text="{Binding Recipe.Garnish}" AutomationProperties.Name="Drink garnish" />
              <TextBlock Text="Complete tags" FontWeight="SemiBold" />
              <TextBox Text="{Binding Tags}" PlaceholderText="featured,region=west"
                       IsVisible="{Binding CanEditTags}" IsEnabled="{Binding CanReplaceTags}"
                       AutomationProperties.Name="Drink tags" />
              <CheckBox Content="Replace the complete tag set atomically" IsChecked="{Binding ReplaceTags}"
                        IsVisible="{Binding CanEditTags}" IsEnabled="{Binding CanReplaceTags}"
                        ToolTip.Tip="{Binding TagsAction.DisabledReason}"
                        AutomationProperties.Name="Replace drink tags"
                        AutomationProperties.HelpText="{Binding TagsAction.AccessibilityDescription}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsSubmitting}"
                        AutomationProperties.Name="Save drink" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsSubmitting}"
                        AutomationProperties.Name="Cancel drink edit" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel IsVisible="{Binding IsDeleteConfirmation}" Spacing="14"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Delete this drink?" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail.Name}" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" IsEnabled="{Binding !IsSubmitting}"
                      AutomationProperties.Name="Confirm delete drink" />
              <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsSubmitting}"
                      AutomationProperties.Name="Cancel delete drink" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,12,0,0"
               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
               AutomationProperties.Name="Drink workspace status"
               AutomationProperties.LiveSetting="Polite" />
  </Grid>
  <UserControl.Styles>
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="16" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.recipeRow">
      <Setter Property="Padding" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>
</UserControl>
