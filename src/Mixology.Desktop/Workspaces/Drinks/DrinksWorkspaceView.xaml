<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:desktop="clr-namespace:Mixology.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:drinks="clr-namespace:Mixology.Desktop.Workspaces.Drinks"
             xmlns:drinkModels="clr-namespace:Mixology.Modules.Drinks.Models"
             xmlns:entities="clr-namespace:Mixology.Kernel.Entities"
             xmlns:system="clr-namespace:System"
             x:Class="Mixology.Desktop.Workspaces.Drinks.DrinksWorkspaceView"
             x:DataType="drinks:DrinksWorkspaceViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <VerticalStackLayout>
        <Label Text="Drinks" FontSize="30" FontAttributes="Bold" />
        <Label Text="Catalog, recipes, and service details" Opacity="0.7" />
      </VerticalStackLayout>
      <Button Grid.Column="1" Text="Filters" Command="{Binding ToggleFiltersCommand}"
              SemanticProperties.Description="Toggle drink filters" />
      <Button Grid.Column="2" Text="Refresh" Command="{Binding RefreshCommand}"
              SemanticProperties.Description="Refresh drinks" />
      <Button Grid.Column="3" Text="Create drink" Command="{Binding StartCreateCommand}"
              IsVisible="{Binding CreateAction.Visible}" IsEnabled="{Binding CreateAction.Enabled}"
              ToolTipProperties.Text="{Binding CreateAction.DisabledReason}"
              SemanticProperties.Description="Create drink"
              SemanticProperties.Hint="{Binding CreateAction.AccessibilityDescription}" />
    </Grid>

    <Border Grid.Row="1" IsVisible="{Binding ShowFilters}" Style="{StaticResource PanelBorderStyle}" Margin="0,16,0,12">
      <VerticalStackLayout Spacing="10">
        <Grid ColumnDefinitions="*,*,*,2*" ColumnSpacing="8">
          <Entry Placeholder="Exact name" Text="{Binding ExactNameFilter}"
                   SemanticProperties.Description="Exact drink name filter" />
          <Entry Grid.Column="1" Placeholder="Category" Text="{Binding CategoryFilter}"
                   SemanticProperties.Description="Drink category filter" />
          <Entry Grid.Column="2" Placeholder="Glass" Text="{Binding GlassFilter}"
                   SemanticProperties.Description="Drink glass filter" />
          <Entry Grid.Column="3" Placeholder="Filter expression" Text="{Binding ExpressionFilter}"
                   SemanticProperties.Description="Drink filter expression" />
        </Grid>
        <Grid ColumnDefinitions="160,Auto,Auto,Auto" ColumnSpacing="8">
          <Entry Text="{Binding PageSize}" Placeholder="Page size"
                   SemanticProperties.Description="Drink page size" />
          <Button Grid.Column="1" Text="Apply" Command="{Binding ApplyFilterCommand}"
                  SemanticProperties.Description="Apply drink filters" />
          <Button Grid.Column="2" Text="Clear" Command="{Binding ClearFilterCommand}"
                  SemanticProperties.Description="Clear drink filters" />
          <Button Grid.Column="3" Text="Filter help" Command="{Binding ToggleFilterHelpCommand}"
                  SemanticProperties.Description="Show drink filter help" />
        </Grid>
        <Label Text="{Binding FilterHelp}" IsVisible="{Binding ShowFilterHelp}"
                   LineBreakMode="WordWrap" SemanticProperties.Description="Drink filter help" />
      </VerticalStackLayout>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="18" Margin="0,12,0,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                     SemanticProperties.Description="Loading drinks" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 SemanticProperties.Description="Drink catalog">
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="drinks:DrinkListItemViewModel">
              <Grid ColumnDefinitions="2*,*,*" Margin="6" ColumnSpacing="8">
                <VerticalStackLayout>
                  <Label Text="{Binding Name}" FontAttributes="Bold" />
                  <Label Text="{Binding Tags}" Opacity="0.65" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="{Binding Category}" />
                <Label Grid.Column="2" Text="{Binding Glass}" />
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
          <Button Text="Previous" Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding HasPreviousPage}" SemanticProperties.Description="Previous drink page" />
          <Label Grid.Column="1" Text="{Binding PageDescription}" HorizontalOptions="Center"
                     VerticalOptions="Center" />
          <Button Grid.Column="2" Text="Next" Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding HasNextPage}" SemanticProperties.Description="Next drink page" />
        </Grid>
      </Grid>

      <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
        <Grid>
          <ScrollView IsVisible="{Binding IsDetail}">
            <VerticalStackLayout Spacing="12">
              <Label Text="{Binding Detail.Name}" FontSize="24" FontAttributes="Bold" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                <Label Text="Category" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="{Binding Detail.Category.Value}" />
                <Label Grid.Row="1" Text="Glass" FontAttributes="Bold" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Detail.Glass.Value}" />
                <Label Grid.Row="2" Text="Status" FontAttributes="Bold" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Detail.Status.Value}" />
                <Label Grid.Row="3" Text="Description" FontAttributes="Bold" />
                <Label Grid.Row="3" Grid.Column="1" Text="{Binding Detail.Description}" LineBreakMode="WordWrap" />
              </Grid>
              <Label Text="Recipe" FontSize="18" FontAttributes="Bold" />
              <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.Recipe.Ingredients}">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="drinkModels:RecipeIngredient">
                    <VerticalStackLayout Margin="0,3">
                      <Label Text="{Binding IngredientId.Value, StringFormat='Ingredient: {0}'}" />
                      <Label Text="{Binding Amount, StringFormat='Amount: {0}'}" />
                      <Label Text="{Binding Optional, StringFormat='Optional: {0}'}" />
                      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Substitutes}">
                        <BindableLayout.ItemTemplate>
                          <DataTemplate x:DataType="entities:IngredientId">
                            <Label Text="{Binding Value, StringFormat='Substitute: {0}'}" />
                          </DataTemplate>
                        </BindableLayout.ItemTemplate>
                      </VerticalStackLayout>
                    </VerticalStackLayout>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>
              <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.Recipe.Steps}">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="system:String">
                    <Label Text="{Binding}" Margin="0,3" />
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>
              <Label Text="{Binding Detail.Recipe.Garnish, StringFormat='Garnish: {0}'}" />
              <Label Text="{Binding Detail.Tags, StringFormat='Tags: {0}'}" />
              <VerticalStackLayout Spacing="8">
                <Button Text="Edit" Command="{Binding StartEditCommand}"
                        IsVisible="{Binding EditAction.Visible}" IsEnabled="{Binding EditAction.Enabled}"
                        ToolTipProperties.Text="{Binding EditAction.DisabledReason}" SemanticProperties.Description="Edit drink"
                        SemanticProperties.Hint="{Binding EditAction.AccessibilityDescription}" />
                <Button Text="Delete" Command="{Binding BeginDeleteCommand}"
                        IsVisible="{Binding DeleteAction.Visible}" IsEnabled="{Binding DeleteAction.Enabled}"
                        ToolTipProperties.Text="{Binding DeleteAction.DisabledReason}" SemanticProperties.Description="Delete drink"
                        SemanticProperties.Hint="{Binding DeleteAction.AccessibilityDescription}" />
              </VerticalStackLayout>
            </VerticalStackLayout>
          </ScrollView>

          <ScrollView IsVisible="{Binding IsForm}" VerticalScrollBarVisibility="Default"
                        SemanticProperties.Description="Drink editor">
            <VerticalStackLayout Spacing="14">
              <Label Text="{Binding FormTitle}" FontSize="24" FontAttributes="Bold" />
              <Label Text="Name" FontAttributes="Bold" />
              <Entry Text="{Binding Name}" SemanticProperties.Description="Drink name" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                  <Label Text="Category" FontAttributes="Bold" />
                  <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                            SemanticProperties.Description="Drink category" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                  <Label Text="Glass" FontAttributes="Bold" />
                  <Picker ItemsSource="{Binding Glasses}" SelectedItem="{Binding Glass}"
                            SemanticProperties.Description="Drink glass" />
                </VerticalStackLayout>
              </Grid>
              <Label Text="Description" FontAttributes="Bold" />
              <Editor Text="{Binding Description}" MinimumHeightRequest="72"
                       SemanticProperties.Description="Drink description" />

              <Grid ColumnDefinitions="*,Auto">
                <Label Text="Recipe ingredients" FontSize="18" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="Add ingredient" Command="{Binding Recipe.AddIngredientCommand}"
                        SemanticProperties.Description="Add recipe ingredient" />
              </Grid>
              <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsCatalogLoading}"
                           SemanticProperties.Description="Loading ingredient catalog" />
              <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recipe.Ingredients}">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="drinks:RecipeIngredientViewModel">
                    <Border Style="{StaticResource RecipeRowBorderStyle}" Margin="0,0,0,10">
                      <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="8">
                          <VerticalStackLayout>
                            <Label Text="Ingredient search" />
                            <Entry Text="{Binding IngredientSearch}"
                                     SemanticProperties.Description="Recipe ingredient search" />
                            <Picker ItemsSource="{Binding IngredientMatches}"
                                      SelectedItem="{Binding SelectedIngredient}"
                                      ItemDisplayBinding="{Binding Display}"
                                      SemanticProperties.Description="Recipe ingredient picker">
                            </Picker>
                          </VerticalStackLayout>
                          <VerticalStackLayout Grid.Column="1">
                            <Label Text="Amount" />
                            <Entry Text="{Binding Amount}" SemanticProperties.Description="Recipe amount" />
                          </VerticalStackLayout>
                          <VerticalStackLayout Grid.Column="2">
                            <Label Text="Unit" />
                            <Picker ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                                      SemanticProperties.Description="Recipe unit" />
                          </VerticalStackLayout>
                          <Button Grid.Column="3" Text="Remove" Command="{Binding RemoveCommand}"
                                  VerticalOptions="End" SemanticProperties.Description="Remove recipe ingredient" />
                        </Grid>
                        <desktop:LabeledCheckBox Text="Optional ingredient" IsChecked="{Binding IsOptional}"
                                  SemanticProperties.Description="Optional recipe ingredient" />
                        <Label Text="Allowed substitutes" FontAttributes="Bold" />
                        <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding SubstituteOptions}">
                          <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="drinks:SubstituteOptionViewModel">
                              <desktop:LabeledCheckBox Text="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,12,4"
                                        SemanticProperties.Description="Recipe substitute" />
                            </DataTemplate>
                          </BindableLayout.ItemTemplate>
                        </FlexLayout>
                      </VerticalStackLayout>
                    </Border>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>

              <Grid ColumnDefinitions="*,Auto">
                <Label Text="Ordered steps" FontSize="18" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="Add step" Command="{Binding Recipe.AddStepCommand}"
                        SemanticProperties.Description="Add recipe step" />
              </Grid>
              <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recipe.Steps}">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="drinks:RecipeStepViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,3">
                      <Entry Text="{Binding Text}" Placeholder="Instruction"
                               SemanticProperties.Description="Recipe step" />
                      <Button Grid.Column="1" Text="↑" Command="{Binding MoveUpCommand}"
                              SemanticProperties.Description="Move recipe step up" />
                      <Button Grid.Column="2" Text="↓" Command="{Binding MoveDownCommand}"
                              SemanticProperties.Description="Move recipe step down" />
                      <Button Grid.Column="3" Text="Remove" Command="{Binding RemoveCommand}"
                              SemanticProperties.Description="Remove recipe step" />
                    </Grid>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>
              <Label Text="Garnish" FontAttributes="Bold" />
              <Entry Text="{Binding Recipe.Garnish}" SemanticProperties.Description="Drink garnish" />
              <Label Text="Complete tags" FontAttributes="Bold" />
              <Entry Text="{Binding Tags}" Placeholder="featured,region=west"
                       IsVisible="{Binding CanEditTags}" IsEnabled="{Binding CanReplaceTags}"
                       SemanticProperties.Description="Drink tags" />
              <desktop:LabeledCheckBox Text="Replace the complete tag set atomically" IsChecked="{Binding ReplaceTags}"
                        IsVisible="{Binding CanEditTags}" IsEnabled="{Binding CanReplaceTags}"
                        ToolTipProperties.Text="{Binding TagsAction.DisabledReason}"
                        SemanticProperties.Description="Replace drink tags"
                        SemanticProperties.Hint="{Binding TagsAction.AccessibilityDescription}" />
              <VerticalStackLayout Spacing="8">
                <Button Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                        SemanticProperties.Description="Save drink" />
                <Button Text="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                        SemanticProperties.Description="Cancel drink edit" />
              </VerticalStackLayout>
            </VerticalStackLayout>
          </ScrollView>

          <VerticalStackLayout IsVisible="{Binding IsDeleteConfirmation}" Spacing="14"
                      VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="Delete this drink?" FontSize="22" FontAttributes="Bold" />
            <Label Text="{Binding Detail.Name}" HorizontalOptions="Center" />
            <VerticalStackLayout Spacing="8">
              <Button Text="Delete" Command="{Binding ConfirmDeleteCommand}" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                      SemanticProperties.Description="Confirm delete drink" />
              <Button Text="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                      SemanticProperties.Description="Cancel delete drink" />
            </VerticalStackLayout>
          </VerticalStackLayout>
        </Grid>
      </Border>
    </Grid>

    <Label Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,12,0,0"
               TextColor="Red"
               SemanticProperties.Description="Drink workspace status"
               />
  </Grid>
</ContentView>
