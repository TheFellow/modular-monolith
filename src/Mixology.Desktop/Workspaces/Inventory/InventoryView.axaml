<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inventory="using:Mixology.Desktop.Workspaces.Inventory"
             x:Class="Mixology.Desktop.Workspaces.Inventory.InventoryView"
             x:DataType="inventory:InventoryViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <StackPanel><TextBlock Text="Inventory" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="On-hand, reserved, available, and unit cost" Opacity="0.7"/></StackPanel>
      <Button Grid.Column="1" Content="Adjust" Command="{Binding BeginAdjustCommand}" IsVisible="{Binding IsAdjustVisible}" IsEnabled="{Binding CanAdjust}" ToolTip.Tip="{Binding AdjustDisabledReason}"/>
      <Button Grid.Column="2" Content="Set" Command="{Binding BeginSetCommand}" IsVisible="{Binding IsSetVisible}" IsEnabled="{Binding CanSet}" ToolTip.Tip="{Binding SetDisabledReason}"/>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8">
      <Grid ColumnDefinitions="*,Auto,120,90,Auto,Auto" ColumnSpacing="8">
        <TextBox PlaceholderText="Server filter expression" Text="{Binding FilterExpression}" AutomationProperties.Name="Inventory filter"/>
        <CheckBox Grid.Column="1" Content="Low stock" IsChecked="{Binding LowStockOnly}" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Column="2" Minimum="0" Value="{Binding LowStockThreshold}" IsEnabled="{Binding LowStockOnly}"/>
        <NumericUpDown Grid.Column="3" Minimum="1" Maximum="100" Value="{Binding PageSize}"/>
        <Button Grid.Column="4" Content="Apply" Command="{Binding ApplyFilterCommand}"/>
        <Button Grid.Column="5" Content="Filter help" Command="{Binding ToggleFilterHelpCommand}"/>
      </Grid>
      <Border Padding="12" BorderThickness="1" IsVisible="{Binding ShowFilterHelp}"><TextBlock Text="{x:Static inventory:InventoryViewModel.FilterHelp}" TextWrapping="Wrap"/></Border>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"/>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="16">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutomationProperties.Name="Inventory">
        <ListBox.ItemTemplate><DataTemplate x:DataType="inventory:InventoryListItemViewModel"><Grid ColumnDefinitions="2*,*,*,*" Margin="4"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding OnHand}"/><TextBlock Grid.Column="2" Text="{Binding Available}"/><TextBlock Grid.Column="3" Text="{Binding Cost}"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="9">
          <StackPanel IsVisible="{Binding !IsEditorVisible}" Spacing="5">
            <TextBlock Text="{Binding SelectedInventory.Name}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedInventory.Stock.IngredientId, StringFormat='Ingredient ID: {0}'}"/>
            <TextBlock Text="{Binding SelectedInventory.Stock.Id, StringFormat='Inventory ID: {0}'}"/>
            <TextBlock Text="{Binding SelectedInventory.Stock.OnHand, StringFormat='On hand: {0}'}"/>
            <TextBlock Text="{Binding SelectedInventory.Stock.Reserved, StringFormat='Reserved: {0}'}"/>
            <TextBlock Text="{Binding SelectedInventory.Stock.Available, StringFormat='Available: {0}'}"/>
            <TextBlock Text="{Binding SelectedInventory.Cost, StringFormat='Cost per unit: {0}'}"/>
            <TextBlock Text="{Binding SelectedInventory.Stock.Tags, StringFormat='Tags: {0}'}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedInventory.Stock.LastUpdated, StringFormat='Updated: {0:g}'}"/>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsAdjustEditor}" Spacing="7">
            <TextBlock Text="Adjust inventory" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Delta (blank for cost-only adjustment)"/><TextBox Text="{Binding EditorDelta}"/>
            <TextBlock Text="Reason"/><ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding EditorReason}"/>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsSetEditor}" Spacing="7">
            <TextBlock Text="Set inventory" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="On-hand quantity"/><TextBox Text="{Binding EditorQuantity}"/>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsEditorVisible}" Spacing="7">
            <TextBlock Text="Unit"/><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding EditorUnit}"/>
            <TextBlock Text="Cost per unit (for example EUR 2.30)"/><TextBox Text="{Binding EditorCost}"/>
            <CheckBox Content="Replace complete tag collection" IsChecked="{Binding ReplaceTags}" IsVisible="{Binding IsTagsVisible}" IsEnabled="{Binding CanReplaceTags}" ToolTip.Tip="{Binding TagsDisabledReason}"/>
            <TextBox PlaceholderText="key=value, featured" Text="{Binding EditorTags}" IsEnabled="{Binding ReplaceTags}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Save" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsSubmitting}"/>
              <Button Content="Cancel" Command="{Binding CancelEditorCommand}" IsEnabled="{Binding !IsSubmitting}"/>
              <TextBlock Text="Unsaved changes" IsVisible="{Binding IsDirty}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
      <Button Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}"/>
      <TextBlock Grid.Column="1" Text="{Binding PageNumber, StringFormat='Page {0}'}" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}"/>
      <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" AutomationProperties.LiveSetting="Polite"/>
      <Button Grid.Column="4" Content="Refresh" Command="{Binding RefreshCommand}"/>
    </Grid>
  </Grid>
</UserControl>
