<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audit="using:Mixology.Desktop.Workspaces.Audit"
             x:Class="Mixology.Desktop.Workspaces.Audit.AuditView"
             x:DataType="audit:AuditViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="Audit" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="Application activity, failures, and touched entities" Opacity="0.7" />
      </StackPanel>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
              AutomationProperties.Name="Refresh audit activity" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Width="150" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}"
                  AutomationProperties.Name="Audit scope" />
        <TextBox Width="210" PlaceholderText="Entity ID or UID" Text="{Binding Entity}"
                 AutomationProperties.Name="Audit entity" />
        <TextBox Width="140" PlaceholderText="Principal" Text="{Binding Principal}"
                 AutomationProperties.Name="Audit principal" />
        <TextBox Width="210" PlaceholderText="Action UID" Text="{Binding Action}"
                 AutomationProperties.Name="Audit action" />
        <TextBox Width="160" PlaceholderText="From date/time" Text="{Binding From}"
                 AutomationProperties.Name="Audit from" />
        <TextBox Width="160" PlaceholderText="To date/time" Text="{Binding To}"
                 AutomationProperties.Name="Audit to" />
        <TextBox Width="80" PlaceholderText="Limit" Text="{Binding PageSize}"
                 AutomationProperties.Name="Audit page size" />
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel>
        <TextBox Text="{Binding Expression}" PlaceholderText="Typed filter, e.g. !success &amp;&amp; error.contains(&quot;permission&quot;)"
                 AutomationProperties.Name="Audit filter expression" />
        <TextBlock Text="{Binding FilterHelp}" Opacity="0.65" TextWrapping="Wrap"
                   AutomationProperties.Name="Audit filter help" />
      </StackPanel>
      <Button Grid.Column="1" Content="Apply filter" Command="{Binding ApplyFilterCommand}"
              AutomationProperties.Name="Apply audit filter" />
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="16">
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
               AutomationProperties.Name="Audit entries">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="audit:AuditRowViewModel">
            <Grid ColumnDefinitions="150,2*,*,*" Margin="4,7">
              <TextBlock Text="{Binding Started}" />
              <TextBlock Grid.Column="1" Text="{Binding Action}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Principal}" />
              <TextBlock Grid.Column="3" Text="{Binding Outcome}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="8">
          <TextBlock Text="Activity detail" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="ID" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Id}" TextWrapping="Wrap" />
          <TextBlock Text="Action" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Action}" TextWrapping="Wrap" />
          <TextBlock Text="Resource" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Resource}" TextWrapping="Wrap" />
          <TextBlock Text="Principal" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Principal}" />
          <TextBlock Text="Started / completed" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Selected.Started}" /><TextBlock Text="{Binding Selected.Completed}" />
          <TextBlock Text="Duration" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Duration}" />
          <TextBlock Text="Error" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Error}" TextWrapping="Wrap" />
          <TextBlock Text="Touched entities" FontWeight="SemiBold" /><TextBlock Text="{Binding Selected.Touches}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
      <Button Content="Previous" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Previous audit page" />
      <Button Grid.Column="1" Content="Next" Command="{Binding NextPageCommand}" AutomationProperties.Name="Next audit page" />
      <StackPanel Grid.Column="2">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
