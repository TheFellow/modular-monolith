<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:desktop="clr-namespace:Mixology.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:audit="clr-namespace:Mixology.Desktop.Workspaces.Audit"
             x:Class="Mixology.Desktop.Workspaces.Audit.AuditView"
             x:DataType="audit:AuditViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <VerticalStackLayout>
        <Label Text="Audit" FontSize="30" FontAttributes="Bold" />
        <Label Text="Application activity, failures, and touched entities" Opacity="0.7" />
      </VerticalStackLayout>
      <Button Grid.Column="1" Text="Refresh" Command="{Binding RefreshCommand}"
              SemanticProperties.Description="Refresh audit activity" />
    </Grid>
    <ScrollView Grid.Row="1" HorizontalScrollBarVisibility="Default">
      <VerticalStackLayout Spacing="8">
        <Picker WidthRequest="150" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}"
                  SemanticProperties.Description="Audit scope" />
        <Entry WidthRequest="210" Placeholder="Entity ID or UID" Text="{Binding Entity}"
                 SemanticProperties.Description="Audit entity" />
        <Entry WidthRequest="140" Placeholder="Principal" Text="{Binding Principal}"
                 SemanticProperties.Description="Audit principal" />
        <Entry WidthRequest="210" Placeholder="Action UID" Text="{Binding Action}"
                 SemanticProperties.Description="Audit action" />
        <Entry WidthRequest="160" Placeholder="From date/time" Text="{Binding From}"
                 SemanticProperties.Description="Audit from" />
        <Entry WidthRequest="160" Placeholder="To date/time" Text="{Binding To}"
                 SemanticProperties.Description="Audit to" />
        <Entry WidthRequest="80" Placeholder="Limit" Text="{Binding PageSize}"
                 SemanticProperties.Description="Audit page size" />
      </VerticalStackLayout>
    </ScrollView>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <VerticalStackLayout>
        <Entry Text="{Binding Expression}" Placeholder="Typed filter, e.g. !success &amp;&amp; error.contains(&quot;permission&quot;)"
                 SemanticProperties.Description="Audit filter expression" />
        <Label Text="{Binding FilterHelp}" Opacity="0.65" LineBreakMode="WordWrap"
                   SemanticProperties.Description="Audit filter help" />
      </VerticalStackLayout>
      <Button Grid.Column="1" Text="Apply filter" Command="{Binding ApplyFilterCommand}"
              SemanticProperties.Description="Apply audit filter" />
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="16">
      <CollectionView ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
               SemanticProperties.Description="Audit entries">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="audit:AuditRowViewModel">
            <Grid ColumnDefinitions="150,2*,*,*" Margin="4,7">
              <Label Text="{Binding Started}" />
              <Label Grid.Column="1" Text="{Binding Action}" LineBreakMode="TailTruncation" />
              <Label Grid.Column="2" Text="{Binding Principal}" />
              <Label Grid.Column="3" Text="{Binding Outcome}" />
            </Grid>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
      <ScrollView Grid.Column="1">
        <VerticalStackLayout Spacing="8">
          <Label Text="Activity detail" FontSize="20" FontAttributes="Bold" />
          <Label Text="ID" FontAttributes="Bold" /><Label Text="{Binding Selected.Id}" LineBreakMode="WordWrap" />
          <Label Text="Action" FontAttributes="Bold" /><Label Text="{Binding Selected.Action}" LineBreakMode="WordWrap" />
          <Label Text="Resource" FontAttributes="Bold" /><Label Text="{Binding Selected.Resource}" LineBreakMode="WordWrap" />
          <Label Text="Principal" FontAttributes="Bold" /><Label Text="{Binding Selected.Principal}" />
          <Label Text="Started / completed" FontAttributes="Bold" />
          <Label Text="{Binding Selected.Started}" /><Label Text="{Binding Selected.Completed}" />
          <Label Text="Duration" FontAttributes="Bold" /><Label Text="{Binding Selected.Duration}" />
          <Label Text="Error" FontAttributes="Bold" /><Label Text="{Binding Selected.Error}" LineBreakMode="WordWrap" />
          <Label Text="Touched entities" FontAttributes="Bold" /><Label Text="{Binding Selected.Touches}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
      </ScrollView>
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
      <Button Text="Previous" Command="{Binding PreviousPageCommand}" SemanticProperties.Description="Previous audit page" />
      <Button Grid.Column="1" Text="Next" Command="{Binding NextPageCommand}" SemanticProperties.Description="Next audit page" />
      <VerticalStackLayout Grid.Column="2">
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        <Label Text="{Binding StatusMessage}" LineBreakMode="WordWrap" />
      </VerticalStackLayout>
    </Grid>
  </Grid>
</ContentView>
