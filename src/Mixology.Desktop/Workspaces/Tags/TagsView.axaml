<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tags="using:Mixology.Desktop.Workspaces.Tags"
             xmlns:tagging="using:Mixology.Modules.Tagging.Models"
             x:Class="Mixology.Desktop.Workspaces.Tags.TagsView"
             x:DataType="tags:TagsViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="Tags" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="Inspect, mutate, and discover exact tag associations" Opacity="0.7" />
      </StackPanel>
      <Button Grid.Column="1" Content="Refresh permissions" Command="{Binding RefreshCommand}"
              AutomationProperties.Name="Refresh tag permissions" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="180,180,*,Auto" ColumnSpacing="8">
      <ComboBox ItemsSource="{Binding VisibleOperations}" SelectedItem="{Binding Operation}"
                AutomationProperties.Name="Tag operation" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding TargetTypes}" SelectedItem="{Binding SelectedType}"
                DisplayMemberBinding="{Binding Label}" AutomationProperties.Name="Tag entity type" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                DisplayMemberBinding="{Binding Display}" AutomationProperties.Name="Tag target" />
      <Button Grid.Column="3" Content="Load targets" Command="{Binding LoadTargetsCommand}"
              AutomationProperties.Name="Load tag targets" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Text="{Binding Value}" PlaceholderText="Tag or key (case-sensitive)"
               AutomationProperties.Name="Tag value" />
      <Button Grid.Column="1" Content="Run" Command="{Binding ExecuteCommand}"
              AutomationProperties.Name="Run tag operation" />
    </Grid>
    <ScrollViewer Grid.Row="3">
      <StackPanel Spacing="16">
        <StackPanel>
          <TextBlock Text="Entity tags" FontSize="20" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding ResultTags}" AutomationProperties.Name="Entity tags">
            <ItemsControl.ItemTemplate>
              <DataTemplate><Border Padding="8" Margin="0,3" BorderThickness="1"><TextBlock Text="{Binding}" /></Border></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Active references" FontSize="20" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding References}" AutomationProperties.Name="Tag references">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="tagging:TagReference">
                <Grid ColumnDefinitions="120,*,220,180" Margin="4,6">
                  <TextBlock Text="{Binding EntityType}" />
                  <TextBlock Grid.Column="1" Text="{Binding EntityName}" />
                  <TextBlock Grid.Column="2" Text="{Binding EntityId}" />
                  <TextBlock Grid.Column="3" Text="{Binding Tag}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Usage summary" FontSize="20" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Summaries}" AutomationProperties.Name="Tag summary">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="tagging:TagSummary">
                <Grid ColumnDefinitions="*,70,70,90,80,70,70" Margin="4,6">
                  <TextBlock Text="{Binding Tag}" />
                  <TextBlock Grid.Column="1" Text="{Binding Total}" />
                  <TextBlock Grid.Column="2" Text="{Binding Drinks}" />
                  <TextBlock Grid.Column="3" Text="{Binding Ingredients}" />
                  <TextBlock Grid.Column="4" Text="{Binding Inventory}" />
                  <TextBlock Grid.Column="5" Text="{Binding Menus}" />
                  <TextBlock Grid.Column="6" Text="{Binding Orders}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="4">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
      <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
