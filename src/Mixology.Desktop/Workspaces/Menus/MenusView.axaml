<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menus="using:Mixology.Desktop.Workspaces.Menus"
             xmlns:models="using:Mixology.Modules.Menus.Models"
             x:Name="MenuRoot"
             x:Class="Mixology.Desktop.Workspaces.Menus.MenusView"
             x:DataType="menus:MenusViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <StackPanel><TextBlock Text="Menus" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Design, verify, and publish the active drinks catalog" Opacity="0.7"/></StackPanel>
      <Button Grid.Column="1" Content="New menu" Command="{Binding StartCreateCommand}" IsVisible="{Binding CanCreate}" AutomationProperties.Name="Create menu"/>
      <Button Grid.Column="2" Margin="8,0,0,0" Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh menus"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="150,*,90,Auto" ColumnSpacing="8">
      <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding FilterStatus}" AutomationProperties.Name="Menu status filter"/>
      <TextBox Grid.Column="1" Text="{Binding FilterExpression}" PlaceholderText="Filter menus" AutomationProperties.Name="Menu filter expression"/>
      <TextBox Grid.Column="2" Text="{Binding PageSize}" PlaceholderText="Limit" AutomationProperties.Name="Menu page size"/>
      <Button Grid.Column="3" Content="Apply filter" Command="{Binding ApplyFilterCommand}" AutomationProperties.Name="Apply menu filter"/>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="16">
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Menus">
        <ListBox.ItemTemplate><DataTemplate x:DataType="menus:MenuRowViewModel"><Grid ColumnDefinitions="2*,*,Auto" Margin="4,7"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Status}"/><TextBlock Grid.Column="2" Text="{Binding Items}"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Menu detail and form">
        <StackPanel Spacing="12">
          <StackPanel IsVisible="{Binding IsDetail}" Spacing="8">
            <TextBlock Text="{Binding Detail.Name}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail.Description}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Detail.Status}"/><TextBlock Text="{Binding Detail.Tags}" TextWrapping="Wrap"/>
            <WrapPanel Orientation="Horizontal">
              <Button Content="Edit" Command="{Binding StartEditCommand}" IsVisible="{Binding CanEdit}" AutomationProperties.Name="Edit menu"/>
              <Button Content="Delete" Command="{Binding BeginDeleteCommand}" IsVisible="{Binding CanDelete}" AutomationProperties.Name="Delete menu"/>
              <Button Content="Publish" Command="{Binding PublishCommand}" IsVisible="{Binding CanPublish}" AutomationProperties.Name="Publish menu"/>
              <Button Content="Return to draft" Command="{Binding DraftCommand}" IsVisible="{Binding CanDraft}" AutomationProperties.Name="Return menu to draft"/>
            </WrapPanel>
            <Border IsVisible="{Binding IsDeleteConfirmation}" Padding="12" BorderThickness="1"><StackPanel><TextBlock Text="Delete this draft menu? This cannot be undone." TextWrapping="Wrap"/><WrapPanel><Button Content="Confirm delete" Command="{Binding DeleteCommand}" AutomationProperties.Name="Confirm delete menu"/><Button Content="Keep menu" Command="{Binding CancelDeleteCommand}"/></WrapPanel></StackPanel></Border>
            <TextBlock Text="Drinks" FontSize="20" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanAddDrink}"><ComboBox ItemsSource="{Binding DrinkOptions}" SelectedItem="{Binding SelectedDrink}" DisplayMemberBinding="{Binding Display}" AutomationProperties.Name="Menu drink picker"/><Button Grid.Column="1" Content="Add drink" Command="{Binding AddDrinkCommand}" AutomationProperties.Name="Add drink to menu"/></Grid>
            <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.Name="Menu drinks"><ItemsControl.ItemTemplate><DataTemplate x:DataType="menus:MenuItemViewModel"><Grid ColumnDefinitions="*,Auto" Margin="0,4"><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Remove" Command="{Binding #MenuRoot.DataContext.RemoveDrinkCommand}" CommandParameter="{Binding}" IsVisible="{Binding #MenuRoot.DataContext.CanRemoveDrink}" AutomationProperties.Name="Remove drink from menu"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Readiness" FontSize="20" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding Findings}" AutomationProperties.Name="Menu readiness findings"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ReadinessFinding"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Grid ColumnDefinitions="160,Auto" ColumnSpacing="8" IsVisible="{Binding CanAnalyze}"><TextBox Text="{Binding TargetMargin}" PlaceholderText="Target margin" AutomationProperties.Name="Menu target margin"/><Button Grid.Column="1" Content="Analyze" Command="{Binding AnalyzeCommand}" AutomationProperties.Name="Analyze menu"/></Grid>
            <TextBlock Text="{Binding AnalysisSummary}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding AnalysisItems}" AutomationProperties.Name="Menu analysis"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:MenuItemAnalysis"><Grid ColumnDefinitions="2*,*,*" Margin="0,3"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Availability}"/><TextBlock Grid.Column="2" Text="{Binding SuggestedPrice}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsForm}" Spacing="8">
            <TextBlock Text="Menu form" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Name"/><TextBox Text="{Binding Name}" AutomationProperties.Name="Menu name"/><TextBlock Text="Description"/><TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="90" AutomationProperties.Name="Menu description"/><TextBlock Text="Tags (case-sensitive CSV)"/><TextBox Text="{Binding Tags}" IsEnabled="{Binding CanEditTags}" AutomationProperties.Name="Menu tags"/>
            <WrapPanel><Button Content="Save" Command="{Binding SaveCommand}" AutomationProperties.Name="Save menu"/><Button Content="Cancel" Command="{Binding CancelFormCommand}" AutomationProperties.Name="Cancel menu form"/></WrapPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><Button Content="Previous" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Previous menu page"/><Button Grid.Column="1" Content="Next" Command="{Binding NextPageCommand}" AutomationProperties.Name="Next menu page"/><StackPanel Grid.Column="2"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"/><TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/></StackPanel></Grid>
  </Grid>
</UserControl>
