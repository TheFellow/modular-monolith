<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="using:Mixology.Desktop"
        xmlns:navigation="using:Mixology.Desktop.Navigation"
        xmlns:audit="using:Mixology.Desktop.Workspaces.Audit"
        xmlns:dashboard="using:Mixology.Desktop.Workspaces.Dashboard"
        xmlns:drinks="using:Mixology.Desktop.Workspaces.Drinks"
        xmlns:ingredients="using:Mixology.Desktop.Workspaces.Ingredients"
        xmlns:inventory="using:Mixology.Desktop.Workspaces.Inventory"
        xmlns:menus="using:Mixology.Desktop.Workspaces.Menus"
        xmlns:orders="using:Mixology.Desktop.Workspaces.Orders"
        xmlns:tags="using:Mixology.Desktop.Workspaces.Tags"
        x:Class="Mixology.Desktop.MainWindow"
        x:DataType="desktop:ShellViewModel"
        Title="Mixology"
        Width="1080"
        Height="720"
        MinWidth="720"
        MinHeight="480">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
      <dashboard:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type drinks:DrinksWorkspaceViewModel}">
      <drinks:DrinksWorkspaceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type ingredients:IngredientsViewModel}">
      <ingredients:IngredientsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type inventory:InventoryViewModel}">
      <inventory:InventoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type menus:MenusViewModel}">
      <menus:MenusView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type orders:OrdersViewModel}">
      <orders:OrdersView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type audit:AuditViewModel}">
      <audit:AuditView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type tags:TagsViewModel}">
      <tags:TagsView />
    </DataTemplate>
  </Window.DataTemplates>
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="220,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="20,14" Background="{DynamicResource AccentBrush}">
      <TextBlock Text="Mixology" FontSize="24" FontWeight="SemiBold" />
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Padding="12" BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <StackPanel Spacing="8">
        <TextBlock Text="Workspaces" FontWeight="SemiBold" Margin="8,0,0,4" />
        <ItemsControl ItemsSource="{Binding Navigation}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="navigation:DesktopNavigationItemViewModel">
              <Button Content="{Binding Label}"
                      Command="{Binding OpenCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding ActiveWorkspace}" />
    <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="12,8"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</Window>
