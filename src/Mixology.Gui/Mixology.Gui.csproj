<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <BuildNativeGui Condition="'$(BuildNativeGui)' == ''">false</BuildNativeGui>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildNativeGui)' == 'true' And $([MSBuild]::IsOSPlatform('OSX'))">net10.0;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildNativeGui)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))">net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">WinExe</OutputType>
    <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">win-x64;win-arm64</RuntimeIdentifiers>
    <UseMaui Condition="'$(TargetFramework)' == 'net10.0-maccatalyst' Or '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">true</UseMaui>
    <SingleProject Condition="'$(UseMaui)' == 'true'">true</SingleProject>
    <MauiXamlInflator Condition="'$(UseMaui)' == 'true'">SourceGen</MauiXamlInflator>
    <ApplicationTitle>Mixology</ApplicationTitle>
    <ApplicationId>com.thefellow.mixology</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    <Description>.NET MAUI desktop composition root for Mixology.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="App.xaml.cs;DesktopRuntime.cs;InverseBooleanConverter.cs;LabeledCheckBox.cs;MainPage.xaml.cs;MauiProgram.cs;Navigation/MauiDirtyNavigationConfirmation.cs;Threading/MauiUiDispatcher.cs;WorkspaceViewHost.cs;Platforms/**/*.cs;Workspaces/**/*.xaml.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseMaui)' == 'true'">
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Condition="'$(UseMaui)' == 'true'" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.HttpListener" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="../Mixology.Application/Mixology.Application.csproj" />
    <ProjectReference Include="../Mixology.Dispatcher/Mixology.Dispatcher.csproj" />
    <ProjectReference Include="../Mixology.Migrations/Mixology.Migrations.csproj" />
    <ProjectReference Include="../Mixology.Modules.Audit/Mixology.Modules.Audit.csproj" />
    <ProjectReference Include="../Mixology.Modules.Ingredients/Mixology.Modules.Ingredients.csproj" />
    <ProjectReference Include="../Mixology.Modules.Drinks/Mixology.Modules.Drinks.csproj" />
    <ProjectReference Include="../Mixology.Modules.Inventory/Mixology.Modules.Inventory.csproj" />
    <ProjectReference Include="../Mixology.Modules.Menus/Mixology.Modules.Menus.csproj" />
    <ProjectReference Include="../Mixology.Modules.Orders/Mixology.Modules.Orders.csproj" />
    <ProjectReference Include="../Mixology.Modules.Tagging/Mixology.Modules.Tagging.csproj" />
    <ProjectReference Include="../Mixology.Presentation/Mixology.Presentation.csproj" />
    <ProjectReference Include="../Mixology.Toolkits.Desktop/Mixology.Toolkits.Desktop.csproj" />
  </ItemGroup>
</Project>
