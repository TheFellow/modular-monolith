<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:desktop="clr-namespace:Mixology.Gui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:orders="clr-namespace:Mixology.Gui.Workspaces.Orders"
             xmlns:models="clr-namespace:Mixology.Modules.Orders.Models"
             xmlns:entities="clr-namespace:Mixology.Kernel.Entities;assembly=Mixology.Kernel"
             x:Name="OrderRoot"
             x:Class="Mixology.Gui.Workspaces.Orders.OrdersView"
             x:DataType="orders:OrdersViewModel">
  <Grid Margin="24,20,24,18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto"><VerticalStackLayout><Label Text="Orders" Style="{StaticResource WorkspaceTitleStyle}"/><Label Text="Place and track immutable fulfillment snapshots" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="Place order" Command="{Binding StartPlaceCommand}" Style="{StaticResource PrimaryButtonStyle}" IsVisible="{Binding CanPlace}" SemanticProperties.Description="Place order"/><Button Grid.Column="2" Margin="8,0,0,0" Text="Refresh" Command="{Binding RefreshCommand}" SemanticProperties.Description="Refresh orders"/></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="140,180,*,90,Auto" ColumnSpacing="8"><Picker ItemsSource="{Binding Statuses}" SelectedItem="{Binding FilterStatus}" SemanticProperties.Description="Order status filter"/><Picker Grid.Column="1" ItemsSource="{Binding Menus}" SelectedItem="{Binding FilterMenu}" ItemDisplayBinding="{Binding Display}" Title="Any menu" SemanticProperties.Description="Order menu filter"/><Entry Grid.Column="2" Text="{Binding FilterExpression}" Placeholder="Filter orders" SemanticProperties.Description="Order filter expression"/><Entry Grid.Column="3" Text="{Binding PageSize}" Placeholder="Limit" SemanticProperties.Description="Order page size"/><Button Grid.Column="4" Text="Apply filter" Command="{Binding ApplyFilterCommand}" SemanticProperties.Description="Apply order filter"/></Grid>
    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="16">
      <Grid RowDefinitions="Auto,*" Background="{StaticResource SurfaceBrush}"><Grid ColumnDefinitions="2*,*,Auto" Padding="10,8" Background="{StaticResource HeaderBackgroundBrush}"><Label Text="ORDER" Style="{StaticResource TableHeaderLabelStyle}"/><Label Grid.Column="1" Text="STATUS" Style="{StaticResource TableHeaderLabelStyle}"/><Label Grid.Column="2" Text="ITEMS" Style="{StaticResource TableHeaderLabelStyle}"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SemanticProperties.Description="Orders"><CollectionView.ItemTemplate><DataTemplate x:DataType="orders:OrderRowViewModel"><Grid ColumnDefinitions="2*,*,Auto" Padding="10,7"><VerticalStackLayout><Label Text="{Binding MenuName}" FontAttributes="Bold"/><Label Text="{Binding Created}" FontSize="11" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Status}"/><Label Grid.Column="2" Text="{Binding Items}"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
      <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}"><ScrollView VerticalScrollBarVisibility="Default" SemanticProperties.Description="Order detail and place form"><VerticalStackLayout Spacing="12">
        <VerticalStackLayout IsVisible="{Binding IsDetail}" Spacing="8">
          <Label Text="Order detail" FontSize="24" FontAttributes="Bold"/><Label Text="{Binding Detail.Id}" LineBreakMode="WordWrap"/><Label Text="{Binding Detail.Status}"/><Label Text="{Binding Detail.Notes}" LineBreakMode="WordWrap"/><Label Text="{Binding Detail.Tags}" LineBreakMode="WordWrap"/>
          <HorizontalStackLayout><Button Text="Complete" Command="{Binding BeginCompleteCommand}" IsVisible="{Binding CanComplete}" SemanticProperties.Description="Complete order"/><Button Text="Cancel order" Command="{Binding BeginCancelOrderCommand}" IsVisible="{Binding CanCancel}" SemanticProperties.Description="Cancel order"/></HorizontalStackLayout>
          <Border IsVisible="{Binding IsCompleteConfirmation}" Padding="12" StrokeThickness="1"><VerticalStackLayout><Label Text="Complete this order? Reserved usage will remain immutable." LineBreakMode="WordWrap"/><HorizontalStackLayout><Button Text="Confirm complete" Command="{Binding CompleteCommand}" SemanticProperties.Description="Confirm complete order"/><Button Text="Keep pending" Command="{Binding DismissConfirmationCommand}"/></HorizontalStackLayout></VerticalStackLayout></Border>
          <Border IsVisible="{Binding IsCancelConfirmation}" Padding="12" StrokeThickness="1"><VerticalStackLayout><Label Text="Cancel this order? This cannot be undone." LineBreakMode="WordWrap"/><HorizontalStackLayout><Button Text="Confirm cancel" Command="{Binding CancelOrderCommand}" SemanticProperties.Description="Confirm cancel order"/><Button Text="Keep order" Command="{Binding DismissConfirmationCommand}"/></HorizontalStackLayout></VerticalStackLayout></Border>
          <Label Text="Ordered items" FontSize="20" FontAttributes="Bold"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding DetailLines}" SemanticProperties.Description="Order items"><BindableLayout.ItemTemplate><DataTemplate x:DataType="orders:OrderLineViewModel"><Label Text="{Binding Display}" Margin="0,3" LineBreakMode="WordWrap"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
          <Label Text="Reserved ingredient usage (immutable)" FontSize="20" FontAttributes="Bold"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.IngredientUsage}" SemanticProperties.Description="Order ingredient usage"><BindableLayout.ItemTemplate><DataTemplate x:DataType="models:IngredientUsage"><Grid ColumnDefinitions="2*,*" Margin="0,3"><Label Text="{Binding Name}"/><Label Grid.Column="1" Text="{Binding Amount}"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
          <Label Text="Blocked ingredient IDs" FontSize="20" FontAttributes="Bold"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.BlockedIngredientIds}" SemanticProperties.Description="Blocked order ingredients"><BindableLayout.ItemTemplate><DataTemplate x:DataType="entities:IngredientId"><Label Text="{Binding Value}" Margin="0,3" LineBreakMode="WordWrap"/></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
        </VerticalStackLayout>
        <VerticalStackLayout IsVisible="{Binding IsPlace}" Spacing="8">
          <Label Text="Place order" FontSize="24" FontAttributes="Bold"/><Label Text="Published menu"/><Picker ItemsSource="{Binding Menus}" SelectedItem="{Binding PlaceMenu}" ItemDisplayBinding="{Binding Display}" SemanticProperties.Description="Order menu"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Picker ItemsSource="{Binding Drinks}" SelectedItem="{Binding PlaceDrink}" ItemDisplayBinding="{Binding Display}" SemanticProperties.Description="Order drink"/><Button Grid.Column="1" Text="Add item" Command="{Binding AddLineCommand}" SemanticProperties.Description="Add order item"/></Grid>
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlaceLines}" SemanticProperties.Description="Order placement items"><BindableLayout.ItemTemplate><DataTemplate x:DataType="orders:OrderPlacementLine"><Grid ColumnDefinitions="2*,80,2*,Auto" ColumnSpacing="8" Margin="0,4"><Label Text="{Binding Drink.Display}" LineBreakMode="WordWrap"/><Entry Grid.Column="1" Text="{Binding Quantity}" SemanticProperties.Description="Order item quantity"/><Entry Grid.Column="2" Text="{Binding Notes}" Placeholder="Line notes" SemanticProperties.Description="Order item notes"/><Button Grid.Column="3" Text="Remove" Command="{Binding Source={x:Reference OrderRoot}, Path=BindingContext.RemoveLineCommand}" CommandParameter="{Binding}" SemanticProperties.Description="Remove order item"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
          <Label Text="Order notes"/><Editor Text="{Binding PlaceNotes}" Placeholder="Order notes" MinimumHeightRequest="70" SemanticProperties.Description="Order notes"/><Label Text="Tags (case-sensitive CSV)"/><Entry Text="{Binding PlaceTags}" SemanticProperties.Description="Order tags"/>
          <HorizontalStackLayout HorizontalOptions="End"><Button Text="Submit order" Command="{Binding PlaceCommand}" Style="{StaticResource PrimaryButtonStyle}" SemanticProperties.Description="Submit order"/><Button Text="Cancel" Command="{Binding CancelPlaceCommand}" SemanticProperties.Description="Cancel order form"/></HorizontalStackLayout>
        </VerticalStackLayout>
      </VerticalStackLayout></ScrollView></Border>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8"><Button Text="Previous" Command="{Binding PreviousPageCommand}" SemanticProperties.Description="Previous order page"/><Button Grid.Column="1" Text="Next" Command="{Binding NextPageCommand}" SemanticProperties.Description="Next order page"/><VerticalStackLayout Grid.Column="2"><ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/><Label Text="{Binding StatusMessage}" LineBreakMode="WordWrap"/></VerticalStackLayout></Grid>
  </Grid>
</ContentView>
