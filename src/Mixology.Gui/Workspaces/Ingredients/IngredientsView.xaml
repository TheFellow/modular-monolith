<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:desktop="clr-namespace:Mixology.Gui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ingredients="clr-namespace:Mixology.Gui.Workspaces.Ingredients"
             x:Class="Mixology.Gui.Workspaces.Ingredients.IngredientsView"
             x:DataType="ingredients:IngredientsViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,18" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <VerticalStackLayout><Label Text="Ingredients" Style="{StaticResource WorkspaceTitleStyle}"/><Label Text="Catalog, substitutions, and tags" Style="{StaticResource SecondaryTextStyle}"/></VerticalStackLayout>
      <Button Grid.Column="1" Text="Create" Command="{Binding BeginCreateCommand}" Style="{StaticResource PrimaryButtonStyle}" IsVisible="{Binding IsCreateVisible}" IsEnabled="{Binding CanCreate}" ToolTipProperties.Text="{Binding CreateDisabledReason}"/>
      <Button Grid.Column="2" Text="Edit" Command="{Binding BeginEditCommand}" IsVisible="{Binding IsEditVisible}" IsEnabled="{Binding CanEdit}" ToolTipProperties.Text="{Binding EditDisabledReason}"/>
      <Button Grid.Column="3" Text="Retire" Command="{Binding BeginRetireCommand}" IsVisible="{Binding IsRetireVisible}" IsEnabled="{Binding CanRetire}" ToolTipProperties.Text="{Binding RetireDisabledReason}"/>
    </Grid>
    <VerticalStackLayout Grid.Row="1" Spacing="8">
      <Grid ColumnDefinitions="*,170,90,Auto,Auto" ColumnSpacing="8">
        <Entry Placeholder="Server filter expression" Text="{Binding FilterExpression}" SemanticProperties.Description="Ingredient filter"/>
        <Picker Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" Title="All categories"/>
        <Entry Grid.Column="2" Text="{Binding PageSize}"/>
        <Button Grid.Column="3" Text="Apply" Command="{Binding ApplyFilterCommand}"/>
        <Button Grid.Column="4" Text="Filter help" Command="{Binding ToggleFilterHelpCommand}"/>
      </Grid>
      <Border Padding="12" StrokeThickness="1" IsVisible="{Binding ShowFilterHelp}"><Label Text="{x:Static ingredients:IngredientsViewModel.FilterHelp}" LineBreakMode="WordWrap"/></Border>
      <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
    </VerticalStackLayout>
    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="16">
      <Grid RowDefinitions="Auto,*" Background="{StaticResource SurfaceBrush}">
        <Grid ColumnDefinitions="2*,*,*" Padding="10,8" Background="{StaticResource HeaderBackgroundBrush}"><Label Text="INGREDIENT" Style="{StaticResource TableHeaderLabelStyle}"/><Label Grid.Column="1" Text="CATEGORY" Style="{StaticResource TableHeaderLabelStyle}"/><Label Grid.Column="2" Text="UNIT" Style="{StaticResource TableHeaderLabelStyle}"/></Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SemanticProperties.Description="Ingredients">
          <CollectionView.ItemTemplate><DataTemplate x:DataType="ingredients:IngredientListItemViewModel"><Grid ColumnDefinitions="2*,*,*" Padding="10,7"><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding Category}"/><Label Grid.Column="2" Text="{Binding Unit}"/></Grid></DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
      </Grid>
      <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}"><ScrollView>
        <VerticalStackLayout Spacing="10">
          <VerticalStackLayout IsVisible="{Binding IsEditorVisible, Converter={StaticResource InverseBoolConverter}}" Spacing="6">
            <Label Text="{Binding SelectedIngredient.Name}" FontSize="22" FontAttributes="Bold"/>
            <Label Text="{Binding SelectedIngredient.Id, StringFormat='ID: {0}'}"/>
            <Label Text="{Binding SelectedIngredient.Category, StringFormat='Category: {0}'}"/>
            <Label Text="{Binding SelectedIngredient.Unit, StringFormat='Unit: {0}'}"/>
            <Label Text="{Binding SelectedIngredient.Tags, StringFormat='Tags: {0}'}" LineBreakMode="WordWrap"/>
            <Label Text="{Binding SelectedIngredient.Description}" LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
          <VerticalStackLayout IsVisible="{Binding IsIngredientEditor}" Spacing="8">
            <Label Text="Ingredient editor" FontSize="22" FontAttributes="Bold"/>
            <Label Text="Name"/><Entry Text="{Binding EditorName}"/>
            <Label Text="Category"/><Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding EditorCategory}"/>
            <Label Text="Unit"/><Picker ItemsSource="{Binding Units}" SelectedItem="{Binding EditorUnit}"/>
            <Label Text="Description"/><Editor Text="{Binding EditorDescription}" MinimumHeightRequest="90"/>
            <desktop:LabeledCheckBox Text="Replace complete tag collection" IsChecked="{Binding ReplaceTags}" IsVisible="{Binding IsTagsVisible}" IsEnabled="{Binding CanReplaceTags}" ToolTipProperties.Text="{Binding TagsDisabledReason}"/>
            <Entry Placeholder="key=value, featured" Text="{Binding EditorTags}" IsEnabled="{Binding ReplaceTags}"/>
          </VerticalStackLayout>
          <VerticalStackLayout IsVisible="{Binding IsRetireEditor}" Spacing="8">
            <Label Text="Retire ingredient" FontSize="22" FontAttributes="Bold"/>
            <Label Text="Replacement ingredient ID (optional)"/><Entry Text="{Binding ReplacementIngredientId}"/>
            <Label Text="Positive replacement ratio"/><Entry Text="{Binding ReplacementRatio}"/>
          </VerticalStackLayout>
          <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsEditorVisible}">
            <Button Text="Save" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"/>
            <Button Text="Cancel" Command="{Binding CancelEditorCommand}" IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"/>
            <Label Text="Unsaved changes" IsVisible="{Binding IsDirty}" VerticalOptions="Center"/>
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </ScrollView></Border>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
      <Button Text="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}"/>
      <Label Grid.Column="1" Text="{Binding PageNumber, StringFormat='Page {0}'}" VerticalOptions="Center"/>
      <Button Grid.Column="2" Text="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}"/>
      <Label Grid.Column="3" Text="{Binding StatusMessage}" TextColor="Red"/>
      <Button Grid.Column="4" Text="Refresh" Command="{Binding RefreshCommand}"/>
    </Grid>
  </Grid>
</ContentView>
