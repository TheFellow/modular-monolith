{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "enableGlobDot": true,
  "ignorePaths": [
    ".git/**",
    "**/bin/**",
    "**/obj/**",
    "external/**",
    "node_modules/**"
  ],
  "ignoreRegExpList": [
    "/\\b[A-Za-z0-9]{20,}\\b/g"
  ],
  "words": [
    "ABAC",
    "aperitivo",
    "Asynchrony",
    "axaml",
    "Avalonia",
    "Blanco",
    "blocke",
    "bstore",
    "buildtransitive",
    "Campari",
    "cedarschema",
    "contentfiles",
    "codespell",
    "csharp",
    "FastTrack",
    "FFFFFFF",
    "FFFFFFFK",
    "fffzzz",
    "finalizer",
    "finalizers",
    "KSUID",
    "KSUIDs",
    "Ksuid",
    "golangci",
    "LASTEXITCODE",
    "LINQ",
    "Linq",
    "Mojito",
    "mocktail",
    "Mocktail",
    "MVVM",
    "Mvvm",
    "Negroni",
    "Newtonsoft",
    "OPTOUT",
    "pushdown",
    "pushdowns",
    "scriptable",
    "Serilog",
    "sharpdetect",
    "Skia",
    "slnx",
    "snupkg",
    "toolkit",
    "toolkits",
    "Toolkits",
    "testhost",
    "testutil",
    "Unmarshal",
    "Vvyt",
    "xunit",
    "Xunit"
  ]
}
